---
// Project gallery with a native <dialog> lightbox (arrows, Escape, click outside to close).
import { Image, getImage } from 'astro:assets';

const { name, items = [] } = Astro.props;
const shots = await Promise.all(
  items.map(async (g, i) => {
    const full = await getImage({ src: g.image, width: Math.min(2560, g.image.width), format: 'webp', quality: 86 });
    return { ...g, full: full.src, alt: `${name}, render ${i + 1} of ${items.length}` };
  }),
);
---
{shots.length > 0 && (
  <section class="gallery" aria-labelledby="gallery-title" data-gallery>
    <h2 id="gallery-title" class="visually-hidden">Gallery</h2>
    <ul class="grid">
      {shots.map((s, i) => (
        <li class:list={[{ lead: i === 0 && shots.length % 2 === 1 }]}>
          <button type="button" class="shot" data-full={s.full} data-alt={s.alt} aria-label={`Open ${s.alt} in full screen`}>
            <Image
              src={s.image}
              alt={s.alt}
              widths={[640, 960, 1440, 1920]}
              sizes={i === 0 && shots.length % 2 === 1 ? '(min-width: 1560px) 1480px, 100vw' : '(min-width: 900px) 48vw, 100vw'}
              quality={80}
            />
          </button>
        </li>
      ))}
    </ul>

    <dialog class="lightbox" aria-label="Image viewer">
      <img class="lb-img" alt="" />
      <p class="lb-count mono" aria-live="polite"></p>
      <button type="button" class="lb-btn lb-prev" aria-label="Previous image"><span aria-hidden="true">←</span></button>
      <button type="button" class="lb-btn lb-next" aria-label="Next image"><span aria-hidden="true">→</span></button>
      <button type="button" class="lb-btn lb-close" aria-label="Close"><span aria-hidden="true">✕</span></button>
    </dialog>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const shots = Array.from(root.querySelectorAll<HTMLButtonElement>('.shot'));
    const dlg = root.querySelector<HTMLDialogElement>('.lightbox');
    const img = root.querySelector<HTMLImageElement>('.lb-img');
    const count = root.querySelector<HTMLElement>('.lb-count');
    if (!dlg || !img) return;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const s = shots[index];
      img.src = s.dataset.full ?? '';
      img.alt = s.dataset.alt ?? '';
      if (count) count.textContent = `${index + 1} / ${shots.length}`;
      const next = shots[(index + 1) % shots.length];
      if (next?.dataset.full) new Image().src = next.dataset.full;
    };

    shots.forEach((s, i) =>
      s.addEventListener('click', () => {
        opener = s;
        show(i);
        dlg.showModal();
      }),
    );

    root.querySelector('.lb-prev')?.addEventListener('click', () => show(index - 1));
    root.querySelector('.lb-next')?.addEventListener('click', () => show(index + 1));
    root.querySelector('.lb-close')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dlg.addEventListener('close', () => opener?.focus());

    if (shots.length < 2) {
      root.querySelectorAll<HTMLElement>('.lb-prev, .lb-next').forEach((b) => (b.hidden = true));
    }
  });
</script>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
  }

  .lead {
    grid-column: 1 / -1;
  }

  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 3px;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    transition: transform 700ms var(--ease), opacity 200ms ease;
  }

  .shot:hover :global(img) {
    transform: scale(1.015);
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(5, 6, 7, 0.96);
    color: var(--fg);
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade 220ms ease both;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  @keyframes fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lb-img {
    max-width: calc(100vw - 2 * max(16px, env(safe-area-inset-left, 0px)) - 120px);
    max-height: calc(100dvh - 120px);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb-count {
    position: absolute;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 20px);
    transform: translateX(-50%);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgba(236, 231, 223, 0.06);
    box-shadow: inset 0 0 0 1px var(--line-2);
    color: var(--fg);
    font-size: 1.1rem;
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .lb-btn:hover {
    background: rgba(236, 231, 223, 0.14);
  }

  .lb-prev { left: max(16px, env(safe-area-inset-left, 0px)); top: 50%; transform: translateY(-50%); }
  .lb-next { right: max(16px, env(safe-area-inset-right, 0px)); top: 50%; transform: translateY(-50%); }
  .lb-close { right: max(16px, env(safe-area-inset-right, 0px)); top: calc(env(safe-area-inset-top, 0px) + 16px); }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .lb-img {
      max-width: 100vw;
    }
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 8px);
      transform: none;
    }
  }
</style>
