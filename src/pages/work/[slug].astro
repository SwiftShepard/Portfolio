---
import Base from '../../layouts/Base.astro';
import Render from '../../components/Render.astro';
import Inspect from '../../components/Inspect.astro';
import Gallery from '../../components/Gallery.astro';
import { projects } from '../../lib/projects.js';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

const { project: p, next } = Astro.props;
const showInspect = Boolean((p.inspectLit && p.inspectWire) || p.modelUrl);
const specs = Object.entries(p.specs ?? {});

// Title over the key art: only for 16:9 key art with an empty zone named in projects.json ("keyTitle").
const keyTitle = p.keyCinematic && p.keyTitle ? p.keyTitle : null;
// Project text in paragraphs, words unchanged: the first sentence opens as an intro, the rest goes
// two sentences per paragraph (a lone second sentence first when the count is odd).
// A blank line ("\n\n") in the JSON description overrides this and sets the breaks by hand.
function toParagraphs(text) {
  if (text.includes('\n\n')) return text.split(/\n\s*\n/).map((t) => t.trim()).filter(Boolean);
  const s = text.split(/(?<=[.!?])\s+(?=[A-Z])/);
  if (s.length < 3) return [text];
  const rest = s.slice(1);
  const out = [s[0]];
  if (rest.length % 2 === 1) out.push(rest.shift());
  for (let i = 0; i < rest.length; i += 2) out.push(rest.slice(i, i + 2).join(' '));
  return out;
}
const paragraphs = toParagraphs(p.description);

const words = p.name.split(' ');
const titleLines = words.length > 1 ? [words.slice(0, -1).join(' '), words[words.length - 1]] : [p.name];
---
<Base title={p.name} description={`${p.name}: ${p.pitch}`} ogImage={p.shareImage}>
  <article>
    <figure
      class:list={['key', { cinematic: p.keyCinematic, titled: keyTitle }]}
      data-pos={keyTitle?.position ?? undefined}
      data-tone={keyTitle?.tone ?? undefined}
    >
      <Render class="key-img" src={p.key} alt={`${p.name}, key render`} loading="eager" fetchpriority="high" vtName={`key-${p.slug}`} />
      {keyTitle && (
        <div class="key-title">
          <h1 class="display">
            {titleLines.map((line, i) => (
              <>
                <span class:list={['line', { pre: titleLines.length > 1 && i === 0 }]} style={`--i: ${i}`}><span>{line}</span></span>{' '}
              </>
            ))}
          </h1>
          <span class="rule" aria-hidden="true"></span>
          <span class="key-meta mono">{p.year} · {p.typeLabel}</span>
        </div>
      )}
    </figure>

    <!-- Text (info) and images (media) are grouped so the side-rail layout can split them into two columns.
         In the stacked layouts the groups dissolve and CSS order restores: head, inspect, story, gallery. -->
    <div class="case container">
      <div class="case-info">
        <header class="head">
          <div class="title">
            <a class="back mono" href="/#work"><span aria-hidden="true">←</span> All work</a>
            {!keyTitle && <h1 class="display">{p.name}</h1>}
            <p class="lead">{p.pitch}</p>
          </div>
          <dl class="spec">
            <dt>Year</dt><dd>{p.year}</dd>
            <dt>Type</dt><dd>{p.typeLabel}</dd>
            <dt>Software</dt><dd>{p.breakdown.software.join(', ')}</dd>
            <dt>Techniques</dt><dd>{p.breakdown.techniques.join(', ')}</dd>
            {specs.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          </dl>
        </header>

        <section class="block story" aria-labelledby="story-title">
          <h2 id="story-title" class="h-section">The project</h2>
          <div class="desc">
            {paragraphs.map((t, i) => <p class:list={[{ intro: i === 0 && paragraphs.length > 1 }]}>{t}</p>)}
          </div>
        </section>
      </div>

      <div class="case-media">
        {showInspect && (
          <div class="block inspect-wrap">
            <Inspect name={p.name} lit={p.inspectLit} wire={p.inspectWire} poster={p.coverImage} modelUrl={p.modelUrl} modelMB={p.modelMB} />
          </div>
        )}
        <div class="block gallery-wrap">
          <Gallery name={p.name} items={p.gallery} layout={p.galleryLayout === 'stack' ? 'stack' : 'mosaic'} />
        </div>
      </div>
    </div>

    {next && next.slug !== p.slug && (
      <nav class="next" aria-label="Next project">
        <a href={`/work/${next.slug}/`} class="container next-inner">
          <span class="mono label">Next project</span>
          <span class="display next-name">{next.name} <span aria-hidden="true">→</span></span>
        </a>
      </nav>
    )}
  </article>
</Base>

<style>
  /* ---- Key art ---- */
  .key {
    position: relative;
    margin: 0;
    background: var(--bg-2);
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .key :global(.key-img) {
    width: auto;
    max-width: 100%;
    max-height: min(86svh, 1200px);
    object-fit: contain;
  }

  .key.cinematic {
    display: block;
    place-items: normal;
  }

  .key.cinematic :global(.key-img) {
    width: 100%;
    max-height: none;
    height: min(56.25vw, 88svh);
    object-fit: cover;
  }

  /* Title card over the empty part of the render */
  .key-title {
    position: absolute;
    display: grid;
    gap: clamp(10px, 1vw, 18px);
    max-width: 44vw;
    color: var(--fg);
  }

  .key[data-pos='bottom-right'] .key-title { right: 4.5vw; bottom: 5.5vw; justify-items: end; text-align: right; }
  .key[data-pos='top-right'] .key-title { right: 4.5vw; top: 5vw; justify-items: end; text-align: right; }
  .key[data-pos='bottom-left'] .key-title { left: 4.5vw; bottom: 5.5vw; justify-items: start; }
  .key[data-pos='top-left'] .key-title { left: 4.5vw; top: 5vw; justify-items: start; }

  .key[data-tone='dark'] .key-title {
    color: #141210;
  }

  .key[data-tone='light'] .key-title {
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  /* Brand line small, model name large, like a product title card. */
  .key-title h1 {
    font-size: clamp(3rem, 0.5rem + 8.5vw, 12rem);
    line-height: 0.86;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .line.pre {
    font-size: 0.3em;
    letter-spacing: 0.14em;
    line-height: 1;
    margin-bottom: 0.2em;
  }

  .line > span {
    display: inline-block;
  }

  .rule {
    width: clamp(48px, 7vw, 120px);
    height: 3px;
    background: currentColor;
    transform-origin: right center;
  }

  .key[data-pos$='left'] .rule {
    transform-origin: left center;
  }

  .key-meta {
    font-size: clamp(0.72rem, 0.6rem + 0.3vw, 0.9rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  /* Reveal: lines rise out of a mask, then the rule draws and the meta fades in.
     Gated on html.js so the title is fully visible without JavaScript. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .key.cinematic :global(.key-img) {
      animation: key-settle 1800ms var(--ease) both;
    }
    :global(html.js) .key-title .line > span {
      animation: line-up 1100ms var(--ease) both;
      animation-delay: calc(450ms + var(--i) * 140ms);
    }
    :global(html.js) .key-title .rule {
      animation: rule-in 900ms var(--ease) 900ms both;
    }
    :global(html.js) .key-title .key-meta {
      animation: meta-in 700ms ease 1100ms both;
    }
  }

  @keyframes key-settle {
    from { transform: scale(1.04); }
    to { transform: none; }
  }
  @keyframes line-up {
    from { transform: translateY(105%); }
    to { transform: none; }
  }
  @keyframes rule-in {
    from { transform: scaleX(0); }
    to { transform: none; }
  }
  @keyframes meta-in {
    from { opacity: 0; }
    to { opacity: 0.78; }
  }

  /* ---- Header below the key art ---- */
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 96px);
    align-items: start;
    padding-top: clamp(40px, 6vw, 88px);
  }

  .title {
    display: grid;
    gap: 20px;
    justify-items: start;
    min-width: 0;
  }

  .back {
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .back:hover {
    color: var(--accent);
  }

  .title h1 {
    font-size: clamp(2.4rem, 1rem + 5.4vw, 6.2rem);
    overflow-wrap: anywhere;
  }

  .head .spec {
    margin-top: 8px;
  }

  .block {
    padding-top: clamp(56px, 7vw, 112px);
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }

  .desc {
    display: grid;
    gap: 1.15em;
    max-width: 62ch;
    color: var(--fg-2);
    font-size: 1.04rem;
    line-height: 1.8;
  }

  .desc .intro {
    color: var(--fg);
    font-size: var(--step-1);
    line-height: 1.5;
    padding-bottom: 0.2em;
  }

  .next {
    margin-top: clamp(72px, 9vw, 144px);
    border-top: 1px solid var(--line);
  }

  .next-inner {
    display: grid;
    gap: 14px;
    padding-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(40px, 5vw, 72px);
    text-decoration: none;
  }

  .label {
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .next-name {
    font-size: clamp(2rem, 1rem + 4vw, 4.8rem);
    transition: color 200ms ease;
  }

  .next-inner:hover .next-name {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .head,
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---- Case layout. Below 1100 px: one stacked column; the two groups dissolve into it. ---- */
  .case {
    display: flex;
    flex-direction: column;
  }

  .case-info,
  .case-media {
    display: contents;
  }

  .head { order: 1; }
  .inspect-wrap { order: 2; }
  .story { order: 3; }
  .gallery-wrap { order: 4; }

  /* ---- Desktop (1100 px and up): sticky info rail on the left, renders on the right. ---- */
  @media (min-width: 1100px) {
    .case {
      display: grid;
      grid-template-columns: minmax(340px, 0.34fr) minmax(0, 1fr);
      gap: clamp(36px, 4vw, 80px);
      align-items: start;
      padding-top: clamp(40px, 4vw, 72px);
    }

    .case-info,
    .case-media {
      display: block;
    }

    .case-info {
      position: sticky;
      top: calc(var(--nav-h) + 28px);
      max-height: calc(100svh - var(--nav-h) - 56px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      padding-right: 8px;
    }

    .case-info .head,
    .case-info .story {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 0;
    }

    .case-info .story {
      padding-top: 40px;
    }

    .case-info .story h2 {
      font-size: var(--step-1);
    }

    .case-info .desc {
      font-size: 0.98rem;
    }

    .case-info .desc .intro {
      font-size: 1.12rem;
    }

    .case-media > .block:first-child {
      padding-top: 0;
    }
  }

  /* On narrow screens the render is too small to hold the title: it moves under the image. */
  @media (max-width: 900px) {
    .key.titled .key-title {
      position: static;
      max-width: none;
      justify-items: start;
      text-align: left;
      color: var(--fg);
      text-shadow: none;
      padding: 28px max(var(--gutter), env(safe-area-inset-right, 0px)) 0 max(var(--gutter), env(safe-area-inset-left, 0px));
    }
    .key.titled .rule {
      transform-origin: left center;
    }
    .key.titled {
      border-bottom: 0;
    }
  }
</style>
