---
import Base from '../layouts/Base.astro';
import { projects, site } from '../lib/projects.js';

const skills = ['3D modeling', 'Rendering', 'Animation', 'Texturing', 'Lighting', 'UV unwrapping', 'Sculpting', 'VR / AR'];

const software = [
  { group: '3D and sculpting', items: ['Blender', 'ZBrush', 'Autodesk 3ds Max', 'Autodesk Fusion 360'] },
  { group: 'Texturing and materials', items: ['Substance Designer', 'Substance Painter'] },
  { group: 'Cloth and simulation', items: ['Marvelous Designer'] },
  { group: 'Rendering and presentation', items: ['Marmoset Toolbag'] },
  { group: 'Game engines', items: ['Unreal Engine', 'Unity'] },
];

const experience = [
  {
    year: '2024',
    role: 'Freelance',
    place: 'Custom airsoft design',
    points: [],
  },
  {
    year: '2023',
    role: '3D Character & Props Artist (apprenticeship)',
    place: 'Dassault Systèmes, Vélizy-Villacoublay',
    points: [
      'Modeled characters, clothing and accessories',
      'Created hair with Ornatrix',
      'Baked assets and integrated them into internal tools',
      'Optimized performance with LODs',
    ],
  },
  {
    year: '2022',
    role: '3D Artist / QA Engineer',
    place: 'Dassault Systèmes, Vélizy-Villacoublay',
    points: [
      'Created realistic automotive materials',
      'Designed VR scenarios and solved technical issues',
      'QA: bug tracking, quality reports and industry standards',
    ],
  },
  {
    year: '2021',
    role: '3D Environment Artist (5-month internship)',
    place: 'BYN.R Studio, Strasbourg',
    points: [
      'Designed a lobby and a VR level in Unreal Engine 4',
      'High-poly and low-poly modeling with trim sheets',
      'Built shaders and technical solutions',
    ],
  },
  {
    year: '2019',
    role: 'Visual artist (1-month internship)',
    place: 'Cobalt Fx, Montauban-de-Bretagne',
    points: [
      'Made resin objects and set pieces',
      'Props for the Netflix series "Family Business"',
      'Prop bread for Kayser, props for museums and exhibitions',
    ],
  },
];

const education = [
  { year: '2024', title: 'Mastère in Game Art', place: 'IIM Digital School, Nanterre', note: 'Specialization in art for video games.' },
  {
    year: '2022',
    title: "Bachelor's degree in Computer Graphics and Interactive Media",
    place: 'Laval 3Di, Laval',
    note: 'Game Art specialization: environments and game content.',
  },
  { year: '2018', title: 'Baccalauréat, science track', place: 'Lycée La Providence, Montauban', note: '' },
];
---
<Base title="About" description="About Valentin Lothe, game artist: experience at Dassault Systèmes and BYN.R Studio, Mastère in Game Art, software and full CV.">
  <div class="container page">
    <header class="intro">
      <h1 class="display">About</h1>
      <div class="bio">
        <p class="lead">
          3D artist passionate about building immersive worlds and futuristic designs. I specialize in hard-surface
          modeling, photorealistic rendering and environments inspired by science fiction.
        </p>
        <p>
          Every project is a visual exploration that combines technical rigor with bold art direction. I started 3D in
          2018, and I am currently open to full-time roles, freelance work and creative collaborations.
        </p>
        <div class="actions">
          <a class="btn" href={site.cv} download="Valentin-Lothe-CV.pdf">Download CV (PDF)</a>
          <a class="btn ghost" href="/contact/">Contact</a>
        </div>
      </div>
    </header>

    <section class="block two" aria-labelledby="exp-title">
      <h2 id="exp-title" class="h-section">Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li>
            <span class="year mono">{e.year}</span>
            <div class="entry">
              <h3>{e.role}</h3>
              <p class="place">{e.place}</p>
              {e.points.length > 0 && (
                <ul>
                  {e.points.map((pt) => <li>{pt}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block two" aria-labelledby="edu-title">
      <h2 id="edu-title" class="h-section">Education</h2>
      <ol class="timeline">
        {education.map((e) => (
          <li>
            <span class="year mono">{e.year}</span>
            <div class="entry">
              <h3>{e.title}</h3>
              <p class="place">{e.place}</p>
              {e.note && <p class="note">{e.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block two" aria-labelledby="tools-title">
      <h2 id="tools-title" class="h-section">Skills and tools</h2>
      <div class="tools">
        <ul class="chips" aria-label="Skills">
          {skills.map((s) => <li>{s}</li>)}
        </ul>
        <dl class="spec">
          {software.map((s) => (<><dt>{s.group}</dt><dd>{s.items.join(', ')}</dd></>))}
        </dl>
      </div>
    </section>

    <section class="block two" aria-labelledby="proj-title">
      <h2 id="proj-title" class="h-section">Selected projects</h2>
      <ul class="plist">
        {projects.map((p) => (
          <li>
            <a href={`/work/${p.slug}/`}>
              <span class="pname wide">{p.name}</span>
              <span class="mono pmeta">{p.year} · {p.typeLabel}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(48px, 7vw, 112px);
    padding-bottom: clamp(24px, 4vw, 48px);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }

  .intro h1 {
    font-size: clamp(3rem, 1rem + 7vw, 7.5rem);
  }

  .bio {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  .bio > p:not(.lead) {
    color: var(--fg-2);
    max-width: 62ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .block {
    padding-top: clamp(64px, 8vw, 128px);
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .timeline > li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 16px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .year {
    color: var(--accent);
    font-size: 0.85rem;
    padding-top: 3px;
  }

  .entry {
    display: grid;
    gap: 4px;
  }

  .entry h3 {
    font-size: 1.12rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .place {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .entry ul {
    margin: 10px 0 0;
    padding-left: 1.1em;
    color: var(--fg-2);
    display: grid;
    gap: 4px;
  }

  .note {
    color: var(--fg-2);
    font-size: 0.98rem;
    margin-top: 6px;
  }

  .tools {
    display: grid;
    gap: 32px;
    min-width: 0;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips li {
    padding: 6px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 0.9rem;
    color: var(--fg-2);
  }

  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plist a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .pname {
    font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
    font-weight: 780;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .plist a:hover .pname {
    color: var(--accent);
  }

  .pmeta {
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .intro,
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
